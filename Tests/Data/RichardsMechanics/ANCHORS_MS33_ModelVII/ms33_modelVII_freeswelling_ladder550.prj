      Physics anchor: (f) regression baseline previously approved by user.
      Reference = the SINGLE final-time output VTU committed beside this PRJ
      (timestep at t_end). vtkdiff (Applications/ApplicationsLib/
      TestDefinition.cpp) matches <regex> against the reference dir, then
      compares output<->reference of IDENTICAL filename. The adaptive
      IterationNumberBasedTimeStepping makes the ts_NNN index reproducible
      only on the canonical binary/toolchain (build maxwell_floor_20260619,
      ogs @ 71366ac0d3); a different toolchain may change the substep count
      and require reference regeneration. Ties to the documented ~1% Model-I
      non-reproducibility (see DSM run-status board / submission README).

      TWO-TIER TOLERANCES (Vinay's choice 2026-06-23):
        * TIGHT - geometry/equilibrium-pinned, reproducible to ~1e-7..1e-8:
            displacement, saturation, porosity, transport_porosity,
            micro_porosity, micro_water_content, dry_density_solid.
        * LOOSE - calibration / stress-path-sensitive; INTENTIONALLY loose
            at rel=1e-2, abs=1e3 Pa to tolerate the documented ~1% scatter.
            THESE FIELDS ARE NOT BIT-CHECKED - they catch gross drift only,
            not last-bit changes:  sigma, swelling_stress, pressure,
            micro_pressure.
        abs floors derived from problem scale (extracted final-state max|.|);
        the 1e3 Pa pressure floor is safely above the s3 machine-eps floor
        (>=1 Pa at the 1e8 Pa suction scale).
      ============================================================
    -->
    <test_definition>
        <!-- TIER A (tight) -->
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>displacement</field><absolute_tolerance>1e-9</absolute_tolerance><relative_tolerance>1e-7</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>saturation</field><absolute_tolerance>1e-8</absolute_tolerance><relative_tolerance>1e-8</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>porosity</field><absolute_tolerance>1e-8</absolute_tolerance><relative_tolerance>1e-7</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>transport_porosity</field><absolute_tolerance>1e-8</absolute_tolerance><relative_tolerance>1e-7</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>micro_porosity</field><absolute_tolerance>1e-8</absolute_tolerance><relative_tolerance>1e-7</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>micro_water_content</field><absolute_tolerance>1e-8</absolute_tolerance><relative_tolerance>1e-7</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>dry_density_solid</field><absolute_tolerance>1e-5</absolute_tolerance><relative_tolerance>1e-8</relative_tolerance></vtkdiff>
        <!-- TIER B (LOOSE - intentional, see comment block above) -->
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>sigma</field><absolute_tolerance>1e3</absolute_tolerance><relative_tolerance>1e-2</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>swelling_stress</field><absolute_tolerance>1e3</absolute_tolerance><relative_tolerance>1e-2</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>pressure</field><absolute_tolerance>1e3</absolute_tolerance><relative_tolerance>1e-2</relative_tolerance></vtkdiff>
        <vtkdiff><regex>ms33_modelVII_freeswelling_ladder550_ts_.*_t_47520000\.0+\.vtu</regex><field>micro_pressure</field><absolute_tolerance>1e3</absolute_tolerance><relative_tolerance>1e-2</relative_tolerance></vtkdiff>
    </test_definition>
